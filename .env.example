# Main server configuration (consumed by scripts/run_server.sh).
HOST=127.0.0.1
PORT=8101

# Required unless HEAVY_TOOL_MODULES is set: set to "auto" to discover tools under
# mini_vlm_toolkit/tools, or provide a comma-separated list of light tool modules
# to load (no mixing).
# scripts/run_server.sh builds TOOL_MODULES from LIGHT_TOOL_MODULES + HEAVY_TOOL_MODULES.
LIGHT_TOOL_MODULES=mini_vlm_toolkit.tools.python_executor.tool,mini_vlm_toolkit.tools.gemini_google_search.tool,mini_vlm_toolkit.tools.serper_google_search.tool,mini_vlm_toolkit.tools.single_url_qa.tool,mini_vlm_toolkit.tools.python_coder.tool,mini_vlm_toolkit.tools.crop.tool,mini_vlm_toolkit.tools.overlay_images.tool,mini_vlm_toolkit.tools.sam3_visualize.tool,mini_vlm_toolkit.tools.drawline.tool,mini_vlm_toolkit.tools.draw_horizontal_line_by_y.tool,mini_vlm_toolkit.tools.draw_vertical_line_by_x.tool,mini_vlm_toolkit.tools.point.tool,mini_vlm_toolkit.tools.zoom_in_subfigure.tool,mini_vlm_toolkit.tools.zoom_in_image_by_bbox.tool

# Optional: append heavy tool modules to TOOL_MODULES (ignored when LIGHT_TOOL_MODULES=auto).
HEAVY_TOOL_MODULES=mini_vlm_toolkit.tools.sam3_segment.tool,mini_vlm_toolkit.tools.grounding_dino.tool,mini_vlm_toolkit.tools.ocr.tool,mini_vlm_toolkit.tools.depth.tool

# Optional: override model server URLs used by heavy tool wrappers.
SAM3_SERVER_URL=http://127.0.0.1:8083
GROUNDING_DINO_SERVER_URL=http://127.0.0.1:8084
OCR_SERVER_URL=http://127.0.0.1:8085
DEPTH_ANYTHING_SERVER_URL=http://127.0.0.1:8082

# Optional: LLM direct generator tool (OpenAI-compatible chat server).
# LLM_DIRECT_MODEL_BASE_URLS=Qwen/Qwen3-8B:http://127.0.0.1:8004/v1,Qwen/Qwen3-Embedding-8B:http://127.0.0.1:8811/v1
# LLM_DIRECT_MODEL_API_KEYS=Qwen/Qwen3-8B:EMPTY,Qwen/Qwen3-Embedding-8B:EMPTY
# LLM_DIRECT_API_KEY=EMPTY

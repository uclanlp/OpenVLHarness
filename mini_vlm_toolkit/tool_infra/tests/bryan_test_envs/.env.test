# .env.test — General test config with SAM3 + local MLLM.
# Usage: ./scripts/run_server.sh .env.test

HOST=127.0.0.1
PORT=8104

# Auto-discover all tools; those whose subserver is unreachable are skipped.
LIGHT_TOOL_MODULES=auto

# Subserver URLs (only SAM3 is available on this machine).
SAM3_SERVER_URL=http://127.0.0.1:8086
GROUNDING_DINO_SERVER_URL=http://127.0.0.1:8084
OCR_SERVER_URL=http://127.0.0.1:8085
DEPTH_ESTIMATION_SERVER_URL=http://127.0.0.1:8087

# LLM direct generator — points to the local Qwen3-VL vLLM instance.
LLM_DIRECT_MODEL_BASE_URLS=Qwen/Qwen3-VL-8B-Instruct:http://127.0.0.1:8222/v1
LLM_DIRECT_MODEL_API_KEYS=Qwen/Qwen3-VL-8B-Instruct:EMPTY
LLM_DIRECT_API_KEY=EMPTY

LMUData=/local/<user>/data/LMUData

# ======================================================================
# Tool Infrastructure — Environment Template
# ======================================================================
#
# Copy to `.env.rui` and fill in placeholder secrets before running the
# tool server. Values marked <REDACTED> must be supplied.
#
# Quick start:
#   cp .env.example.rui .env.rui
#   # edit .env.rui to fill in secrets
#   ./scripts/run_server.sh .env.rui
#
# This file reflects the "Search Tools v2" setup (Serper-based ecosystem)
# that produced our best non-Gemini MMSearch result.

# ---------- Core server ----------
HOST=127.0.0.1
PORT=8102

# LIGHT_TOOL_MODULES=auto discovers every tool module under src/tools/.
# Alternatively, pass a comma-separated module list (no mixing).
LIGHT_TOOL_MODULES=auto

# Optional: append heavy tool modules (requires heavy tool sub-servers).
# HEAVY_TOOL_MODULES=tools.sam3_segment.tool,tools.grounding_dino.tool,tools.ocr.tool,tools.depth.tool

# Heavy-tool sub-server URLs (only used if HEAVY_TOOL_MODULES is set).
SAM3_SERVER_URL=http://127.0.0.1:8086
GROUNDING_DINO_SERVER_URL=http://127.0.0.1:8084
OCR_SERVER_URL=http://127.0.0.1:8085
DEPTH_ANYTHING_SERVER_URL=http://127.0.0.1:8082

# ---------- LLM Direct Generator Tool ----------
# Optional text LLM endpoint for `LLM_Direct_Generator_Tool`.
LLM_DIRECT_MODEL_BASE_URLS=Qwen/Qwen3-8B:http://127.0.0.1:8004/v1
LLM_DIRECT_MODEL_API_KEYS=Qwen/Qwen3-8B:EMPTY
LLM_DIRECT_API_KEY=EMPTY

# ---------- Python Coding Agent Tool ----------
CODING_AGENT_BASE_URL=http://127.0.0.1:8004/v1
CODING_AGENT_MODEL=Qwen/Qwen3-8B
CODING_AGENT_API_KEY=empty

# ---------- Image upload (for reverse image search) ----------
# Local images must be uploaded to public storage before calling Serper Lens.
# Provider: "s3" or "gcs".
IMAGE_UPLOAD_PROVIDER=s3

# AWS S3 config (used when IMAGE_UPLOAD_PROVIDER=s3)
AWS_S3_BUCKET_NAME=<YOUR_S3_BUCKET>
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>
AWS_S3_REGION=us-east-1

# GCS config (uncomment if IMAGE_UPLOAD_PROVIDER=gcs)
# GCS_BUCKET_NAME=<YOUR_GCS_BUCKET>
# GCS_PROJECT_ID=<YOUR_GCP_PROJECT_ID>
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ---------- Dataset root ----------
LMUData=/absolute/path/to/LMUData

# ======================================================================
# Search Tools v2 (Serper-based ecosystem)
# ======================================================================
# Three tools share the same Serper API key:
#   - Text_Search_Tool    : general web / scholar / news / images / maps / ...
#   - Image_Search_Tool   : reverse image search via Serper Lens
#   - Webpage_Visit_Tool  : Serper Scrape API + LLM extraction (Jina fallback)

SERPER_API_KEY=<YOUR_SERPER_API_KEY>

# ---------- Text Search: query classifier (legacy, optional) ----------
# The new agent-driven flow lets the agent set `search_type` explicitly
# (default: "search"), so the classifier is typically NOT invoked.
# Kept for back-compat if you explicitly pass search_type="auto".
#
# Method: sentence_transformer (local, zero-cost) or llm (OpenAI-compatible)
SEARCH_CLASSIFIER_METHOD=llm
SEARCH_CLASSIFIER_MODEL=Qwen/Qwen3-8B
SEARCH_CLASSIFIER_BASE=http://127.0.0.1:8004/v1
SEARCH_CLASSIFIER_KEY=EMPTY
# SEARCH_CLASSIFIER_THRESHOLD=0.45   # only used by sentence_transformer

# ---------- Text Search: enabled sub-categories ----------
# Comma-separated. Default: all 8 types. Uncomment to restrict.
# SEARCH_ENABLED_TYPES=search,images,scholar,news,maps,places,shopping,patents

# ---------- LLM summarization (Text / Image Search) ----------
# When true: raw Serper snippets -> LLM -> coherent summary with [1][2] citations.
# When false: raw formatted snippets returned directly (faster, no LLM cost).
# Run 5 best-setting: false (summarization was actively losing info in our tests).
SEARCH_LLM_SUMMARIZE=false

# Local vLLM serving the summarization / extraction model
SEARCH_LLM_MODEL=Qwen/Qwen3-8B
SEARCH_LLM_BASE_URL=http://127.0.0.1:8004/v1
SEARCH_LLM_API_KEY=EMPTY
SEARCH_LLM_ENABLE_THINKING=false
#   Set true to enable Qwen3 <think> reasoning in summarization.
#   Default false — thinking bloats context and slows inference.
SEARCH_LLM_MAX_TOKENS=4096
#   Increase only if summaries get truncated. 4096 is enough for 10 results.

# Alternative: OpenAI (uncomment and comment out the Qwen block above)
# SEARCH_LLM_MODEL=gpt-4o-mini
# SEARCH_LLM_BASE_URL=https://api.openai.com/v1
# SEARCH_LLM_API_KEY=<YOUR_OPENAI_API_KEY>

# ---------- Gemini Google Search (optional override) ----------
# When true, Text_Search_Tool replaces the Serper+LLM path with a single
# Gemini call that does Google search + grounding internally.
SEARCH_USE_GEMINI=false
# GOOGLE_API_KEY=<YOUR_GOOGLE_API_KEY>
# GEMINI_SEARCH_MODEL=gemini-2.5-flash
# GEMINI_SEARCH_MAX_TOKENS=8192

# ---------- Webpage Visit ----------
# LLM used to extract goal-relevant content from scraped pages.
# Defaults fall back to SEARCH_LLM_* / LLM_* chain when unset.
# WEBPAGE_VISIT_LLM_MODEL=Qwen/Qwen3-8B
# WEBPAGE_VISIT_LLM_BASE_URL=http://127.0.0.1:8004/v1
# WEBPAGE_VISIT_LLM_API_KEY=EMPTY
WEBPAGE_VISIT_LLM_ENABLE_THINKING=false
# WEBPAGE_VISIT_LLM_MAX_TOKENS=16384
# WEBPAGE_VISIT_MAX_URLS=5
# WEBPAGE_VISIT_MAX_CONTENT_CHARS=120000

# Jina Reader API: secondary fallback when Serper Scrape fails.
# JINA_API_KEY=<YOUR_JINA_API_KEY>

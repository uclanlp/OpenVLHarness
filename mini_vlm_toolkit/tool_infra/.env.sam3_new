# Minimal env for testing the sam3_segment_new tool.
# Usage: bash scripts/run_server.sh .env.sam3_new
HOST=127.0.0.1
PORT=8103

# Auto-discover all tools so SAM3_Segment_New_Tool gets picked up.
LIGHT_TOOL_MODULES=auto

# Point to the refactored SAM3 server on port 8086.
SAM3_NEW_SERVER_URL=http://127.0.0.1:8086

# Keep existing SAM3 server URL if you also want the old tool available.
SAM3_SERVER_URL=http://127.0.0.1:8083

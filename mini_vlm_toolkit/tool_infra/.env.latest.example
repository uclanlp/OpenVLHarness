# Minimal env for testing the sam3_segment tool.
# Usage: bash scripts/run_server.sh .env.sam3
HOST=127.0.0.1
PORT=8101

# Auto-discover all tools so heavy tool gets picked up.
LIGHT_TOOL_MODULES=auto
# HEAVY_TOOL_MODULES=tools.sam3_segment.tool

SAM3_SERVER_URL=http://127.0.0.1:8086
OCR_SERVER_URL=http://127.0.0.1:8085
DEPTH_ESTIMATION_SERVER_URL=http://127.0.0.1:8087
CODING_AGENT_BASE_URL=http://127.0.0.1:8222
CODING_AGENT_MODEL=Qwen/Qwen3-VL-8B-Instruct
CODING_AGENT_API_KEY=empty

# Image upload for reverse image search (local images → public URL)
# AWS S3 config (uncomment to use S3 instead)
IMAGE_UPLOAD_PROVIDER=s3
AWS_S3_BUCKET_NAME=<FILLED_BY_USER>
AWS_ACCESS_KEY_ID=<FILLED_BY_USER>
AWS_SECRET_ACCESS_KEY=<FILLED_BY_USER>
AWS_S3_REGION=<FILLED_BY_USER>

# ======== Serper Search Tools ========
# Shared API key for Text_Search_Tool, Image_Search_Tool, Webpage_Visit_Tool
SERPER_API_KEY=<FILLED_BY_USER>

# ---------- LLM Summarization (Text Search + Image Search) ----------
# When true: raw results → LLM → coherent summary with citations [1][2]...
# When false: raw formatted results returned directly (faster, no LLM cost)
SEARCH_LLM_SUMMARIZE=false

# ---------- Webpage_Visit_Tool LLM config ----------
# Only affects Webpage_Visit_Tool (not Python_Code_Generator, etc.)
WEBPAGE_VISIT_LLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
WEBPAGE_VISIT_LLM_BASE_URL=http://127.0.0.1:8222/v1
WEBPAGE_VISIT_LLM_API_KEY=EMPTY
WEBPAGE_VISIT_LLM_ENABLE_THINKING=false
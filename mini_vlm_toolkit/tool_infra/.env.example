# Main server configuration (consumed by scripts/run_server.sh).
HOST=127.0.0.1
PORT=8101

# Required unless HEAVY_TOOL_MODULES is set: set to "auto" to discover tools under
# src/tools, or provide a comma-separated list of light tool modules
# to load (no mixing).
# scripts/run_server.sh builds TOOL_MODULES from LIGHT_TOOL_MODULES + HEAVY_TOOL_MODULES.
LIGHT_TOOL_MODULES=tools.python_executor.tool,tools.gemini_google_search.tool,tools.serper_google_search.tool,tools.serpapi_image_search.tool,tools.single_url_qa.tool,tools.webpage_visit.tool,tools.python_coder.tool,tools.crop.tool,tools.overlay_images.tool,tools.drawline.tool,tools.draw_horizontal_line_by_y.tool,tools.draw_vertical_line_by_x.tool,tools.point.tool,tools.zoom_in_subfigure.tool,tools.zoom_in_image_by_bbox.tool

# Optional: append heavy tool modules to TOOL_MODULES (ignored when LIGHT_TOOL_MODULES=auto).
HEAVY_TOOL_MODULES=tools.sam3_segment.tool,tools.grounding_dino.tool,tools.ocr.tool,tools.depth.tool

# Optional: override model server URLs used by heavy tool wrappers.
SAM3_SERVER_URL=http://127.0.0.1:8086
GROUNDING_DINO_SERVER_URL=http://127.0.0.1:8084
OCR_SERVER_URL=http://127.0.0.1:8085
DEPTH_ANYTHING_SERVER_URL=http://127.0.0.1:8082

# Optional: Webpage_Visit_Tool LLM override (only affects this tool).
# If unset, falls back to LLM_MODEL/LLM_BASE_URL/LLM_API_KEY, then config.py defaults.
# WEBPAGE_VISIT_LLM_MODEL=gpt-5-mini
# WEBPAGE_VISIT_LLM_BASE_URL=https://api.openai.com/v1
# WEBPAGE_VISIT_LLM_API_KEY=sk-proj-...

# Optional: LLM direct generator tool (OpenAI-compatible chat server).
# LLM_DIRECT_MODEL_BASE_URLS=Qwen/Qwen3-8B:http://127.0.0.1:8004/v1,Qwen/Qwen3-Embedding-8B:http://127.0.0.1:8811/v1
# LLM_DIRECT_MODEL_API_KEYS=Qwen/Qwen3-8B:EMPTY,Qwen/Qwen3-Embedding-8B:EMPTY
# LLM_DIRECT_API_KEY=EMPTY

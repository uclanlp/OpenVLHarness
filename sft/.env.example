# SFT Environment Variables
# Copy this file to the project root .env and fill in your values.

# Data paths
SFT_DATA_ROOT=/path/to/your/sft/training/data
LMUData=/path/to/your/evaluation/data

# Model save directory (optional, defaults to sft/saves/)
# SFT_SAVE_ROOT=/path/to/model/output

# WandB — each user MUST set their own API key
# Get your key at https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=visual-tooluse-sft
# WANDB_ENTITY=your_team_or_username
